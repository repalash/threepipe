{
    "name": "threepipe-cloud",
    "type": "module",
    "scripts": {
        "dev": "teeny dev --local",
        "migrate": "teeny deploy --local",
        "init-infra": "bash scripts/init-infra.sh",
        "deploy": "teeny deploy --remote",
        "deploy:ci": "bash scripts/deploy-ci.sh",
        "secrets-upload": "teeny secrets --remote --upload",
        "cf-typegen": "wrangler types --env-interface CloudflareBindings --env-file .dev.vars.example",
        "typecheck": "npm run cf-typegen && tsc --noEmit -p tsconfig.json",
        "test": "bash scripts/e2e.sh"
    },
    "dependencies": {
        "hono": "^4",
        "marked": "^16.4.2",
        "teenybase": "0.1.1"
    },
    "devDependencies": {
        "typescript": "^5",
        "wrangler": "^4"
    },
    "private": true,
    "description": "threepipe cloud: accounts, access links for agents, uploads and the files host (teenybase on Cloudflare Workers + D1 + R2)"
}
