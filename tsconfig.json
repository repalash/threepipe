
{
    "compilerOptions": {
        "strict": false,
        "types": ["*"],
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "experimentalDecorators": true,
        "isolatedModules": true,
        "module": "es2020",
        "noImplicitAny": true,
        "declaration": true,
        "declarationMap": true,
        "declarationDir": "dist",
        "skipLibCheck": true,
        "noImplicitThis": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "removeComments": false,
        "preserveConstEnums": true,
        "moduleResolution": "bundler",
        "emitDecoratorMetadata": false,
        "sourceMap": false,
        "inlineSources": false,
        "target": "ES2020",
        "strictNullChecks": true,
        "jsx": "react-jsx",
        "allowImportingTsExtensions": false,
        "paths": {
        },
        "lib": [
            "es2020",
            "esnext",
            "dom"
        ]
    },
    "include": [
        "./src/**/*",
        "node_modules/@types/wicg-file-system-access/index.d.ts",
        "website/**/*.ts",
        "website/**/*.vue",
        "website/**/*.md"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "examples",
        "experiments",
        "**/*.spec.ts"
    ],
    "vueCompilerOptions": {
        "vitePressExtensions": [".md"],
    }
}
