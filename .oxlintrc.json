{
    // `npm run lint`. Every rule is an error (no warnings), and the code passes all of them: any output is from the change being made.
    // Files written in another style are listed in the overrides below instead of being reformatted.
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript"],
    "categories": {"correctness": "off"},
    "jsPlugins": ["@stylistic/eslint-plugin", "./scripts/oxlint-naming.mjs"],
    "env": {"browser": true, "node": true, "es2022": true},
    "ignorePatterns": [
        "**/*.jsx", "**/*.vue", "**/*.svelte", "**/*.d.ts",
        ".claude/**", // agent worktrees
        // generated
        "plugins/gaussian-splatting/src/three-gaussian-splat/cpp-sorter/sort.js",
        // vendored code, kept as close to upstream as possible
        "plugins/svg-renderer/src/three-svg-renderer/**",
        "plugins/svg-renderer/src/three-mesh-halfedge/**",
        "plugins/blend-importer/src/js-blend/**",
        "src/assetmanager/import/OBJLoader2.ts",
        "src/assetmanager/import/MTLLoader2.ts",
        "src/three/controls/PivotControls.ts"
    ],
    "rules": {
        // Mistakes
        "for-direction": "error",
        "no-async-promise-executor": "error",
        "no-case-declarations": "error",
        "no-class-assign": "error",
        "no-compare-neg-zero": "error",
        "no-cond-assign": "error",
        "no-constant-condition": "error",
        "no-control-regex": "error",
        "no-debugger": "error",
        "no-delete-var": "error",
        "no-dupe-else-if": "error",
        "no-duplicate-case": "error",
        "no-empty": "error",
        "no-empty-character-class": "error",
        "no-empty-pattern": "error",
        "no-ex-assign": "error",
        "no-extra-boolean-cast": "error",
        "no-fallthrough": "error",
        "no-global-assign": "error",
        "no-inner-declarations": "error",
        "no-invalid-regexp": "error",
        "no-irregular-whitespace": "error",
        "no-loop-func": "error",
        "no-loss-of-precision": "error",
        "no-misleading-character-class": "error",
        "no-nonoctal-decimal-escape": "error",
        "no-prototype-builtins": "error",
        "no-regex-spaces": "error",
        "no-self-assign": "error",
        "no-shadow": "error",
        "no-shadow-restricted-names": "error",
        "no-sparse-arrays": "error",
        "no-unexpected-multiline": "error",
        "no-unsafe-finally": "error",
        "no-unsafe-optional-chaining": "error",
        "no-unused-labels": "error",
        "no-unused-vars": ["error", {"args": "after-used", "argsIgnorePattern": "^_", "caughtErrors": "none"}],
        "no-useless-backreference": "error",
        "no-useless-catch": "error",
        "no-useless-escape": "error",
        "no-with": "error",
        "require-yield": "error",
        "use-isnan": "error",

        // Modern syntax
        "default-param-last": "error",
        "no-array-constructor": "error",
        "no-duplicate-imports": ["error", {"includeExports": false, "allowSeparateTypeImports": true}],
        "no-var": "error",
        "prefer-const": "error",
        "prefer-rest-params": "error",
        "prefer-spread": "error",

        // TypeScript
        "typescript/adjacent-overload-signatures": "error",
        "typescript/ban-ts-comment": "error",
        "typescript/consistent-type-definitions": ["error", "interface"],
        "typescript/no-empty-interface": "error",
        "typescript/no-extra-non-null-assertion": "error",
        "typescript/no-inferrable-types": ["error", {"ignoreParameters": true}],
        "typescript/no-misused-new": "error",
        "typescript/no-namespace": "error",
        "typescript/no-non-null-asserted-optional-chain": "error",
        "typescript/no-this-alias": "error",
        "typescript/no-unnecessary-type-constraint": "error",
        "typescript/no-var-requires": "error",
        "typescript/prefer-as-const": "error",
        "typescript/prefer-for-of": "error",
        "typescript/prefer-function-type": "error",
        "typescript/prefer-namespace-keyword": "error",
        "typescript/prefer-ts-expect-error": "error",
        "typescript/triple-slash-reference": "error",

        // Formatting the code already follows (the ESLint plugin runs inside oxlint). Like the old ESLint core rules,
        // indentation inside type annotations and spacing in type unions are not checked.
        "@stylistic/indent": ["error", 4, {"SwitchCase": 0, "ignoredNodes": ["PropertyDefinition[decorators.length>0]", "TSAbstractPropertyDefinition[decorators.length>0]", "[type=/^TS/]", "[type=/^TS/] *"]}],
        "@stylistic/quotes": ["error", "single"],
        "@stylistic/semi": ["error", "never", {"beforeStatementContinuationChars": "always"}],
        "@stylistic/comma-dangle": ["error", {"arrays": "always-multiline", "objects": "always-multiline", "imports": "always-multiline", "exports": "always-multiline", "functions": "only-multiline"}],
        "@stylistic/object-curly-spacing": ["error", "never"],
        "@stylistic/comma-spacing": "error",
        "@stylistic/keyword-spacing": "error",
        "@stylistic/space-before-function-paren": ["error", {"anonymous": "never", "named": "never", "asyncArrow": "never", "catch": "always"}],
        "@stylistic/space-infix-ops": ["error", {"ignoreTypes": true}],
        "@stylistic/no-trailing-spaces": ["error", {"skipBlankLines": true}],
        "@stylistic/brace-style": ["error", "1tbs", {"allowSingleLine": true}],

        // Naming (scripts/oxlint-naming.mjs)
        "naming/private-underscore": "error",
        "naming/type-pascal-case": "error"
    },
    "overrides": [
        // JavaScript (scripts, configs, the examples index): the mistakes only, it is written in several styles
        {"files": ["**/*.js", "**/*.mjs", "**/*.cjs"],
         "rules": {"@stylistic/indent": "off", "@stylistic/quotes": "off", "@stylistic/semi": "off", "@stylistic/comma-dangle": "off", "@stylistic/object-curly-spacing": "off", "@stylistic/comma-spacing": "off", "@stylistic/keyword-spacing": "off", "@stylistic/space-before-function-paren": "off", "@stylistic/space-infix-ops": "off", "@stylistic/no-trailing-spaces": "off", "@stylistic/brace-style": "off", "naming/private-underscore": "off", "naming/type-pascal-case": "off"}},
        // Written in another style, not reformatted
        {"files": [
            "playwright.config.ts",
            "plugins/blend-importer/src/BlendLoadPlugin.ts",
            "plugins/blend-importer/src/loader/material.ts",
            "plugins/gaussian-splatting/src/three-gaussian-splat/cpp-sorter/BufferPool.ts",
            "plugins/plugin-template-vite/src/SamplePlugin.ts",
            "plugins/tweakpane-editor/src/StickyNotesUiPlugin.ts",
            "plugins/webgi-plugins/src/passes/BilateralFilterPass.ts",
            "plugins/webgi-plugins/src/plugins/buffer/VelocityBufferPlugin.ts",
            "plugins/webgi-plugins/src/plugins/extras/AnisotropyPlugin.ts",
            "plugins/webgi-plugins/src/plugins/extras/WatchHandsPlugin.ts",
            "plugins/webgi-plugins/src/plugins/index.ts",
            "plugins/webgi-plugins/src/plugins/postprocessing/SSGIPlugin.ts",
            "plugins/webgi-plugins/src/plugins/postprocessing/SSReflectionPlugin.ts",
            "plugins/webgi-plugins/src/plugins/postprocessing/TemporalAAPlugin.ts",
            "plugins/webgi-plugins/src/utils/RandomizedDirectionalLight.ts",
            "plugins/webgi-plugins/src/utils/Reflector2.ts",
            "plugins/webgi-plugins/src/utils/ShadowMapBaker.ts",
            "plugins/webgi-plugins/src/utils/shaders.ts",
            "src/core/object/iCameraCommons.ts",
            "src/plugins/geometry/ShapeTubeExtrudePlugin.ts",
            "src/postprocessing/ExtendedCopyPass.ts",
            "tests/helpers.ts",
            "tests/interactive.spec.ts",
            "tests/unit/sticky-notes-ui-plugin.test.ts",
            "website/.vitepress/config.ts"
        ],
        "rules": {
            "@stylistic/indent": "off",
            "@stylistic/quotes": "off",
            "@stylistic/semi": "off",
            "@stylistic/comma-dangle": "off",
            "@stylistic/object-curly-spacing": "off",
            "@stylistic/comma-spacing": "off",
            "@stylistic/keyword-spacing": "off",
            "@stylistic/space-before-function-paren": "off",
            "@stylistic/space-infix-ops": "off",
            "@stylistic/no-trailing-spaces": "off",
            "@stylistic/brace-style": "off"
        }},
        // Older code that breaks a rule, left as it is
        {"files": ["plugins/webgi-plugins/src/utils/Reflector2.ts"], "rules": {"default-param-last": "off"}},
        {"files": ["plugins/gaussian-splatting/src/three-gaussian-splat/cpp-sorter/BufferPool.ts"], "rules": {"naming/private-underscore": "off"}},
        {"files": ["plugins/r3f/src/useViewerImporter.tsx"], "rules": {"no-duplicate-imports": "off"}},
        {"files": ["tests/precache-cdn.mjs", "tests/unit/tweakpane-editor-frame.test.ts"], "rules": {"no-loop-func": "off"}},
        {"files": ["examples/_index/editor/setup.mjs", "tests/interactive.spec.ts", "tests/unit/blend-importer-material.test.ts", "tests/unit/notes-plugin.test.ts", "tests/unit/render-preview.test.ts", "tests/unit/sticky-notes-ui-plugin.test.ts"], "rules": {"no-shadow": "off"}},
        {"files": ["examples/_index/editor/loadTypes.mjs", "examples/_index/editor/setup.mjs", "plugins/webgi-plugins/src/plugins/postprocessing/SSGIPlugin.ts", "tests/precache-cdn.mjs", "website/public/scripts/home-viewer.js"], "rules": {"prefer-const": "off"}},
        {"files": ["plugins/blend-importer/src/loader/geometry.ts"], "rules": {"typescript/consistent-type-definitions": "off"}},
        {"files": ["plugins/webgi-plugins/src/utils/FSShadowMaterial.ts"], "rules": {"typescript/no-inferrable-types": "off"}},
        {"files": ["plugins/webgi-plugins/src/plugins/extras/AdvancedGroundPlugin.ts"], "rules": {"typescript/no-non-null-asserted-optional-chain": "off"}},
        {"files": ["tests/unit/sticky-notes-ui-plugin.test.ts", "tests/unit/tweakpane-editor-frame.test.ts"], "rules": {"typescript/no-this-alias": "off"}},
        {"files": ["plugins/webgi-plugins/src/utils/FSShadowMaterial.ts"], "rules": {"typescript/prefer-as-const": "off"}},
        {"files": ["src/plugins/geometry/primitives/geometry-generators.test.ts"], "rules": {"typescript/prefer-for-of": "off"}},
        {"files": ["examples/_index/editor/loadTypes.mjs"], "rules": {"no-constant-condition": "off"}},
        // Unused variables, to fix or keep file by file in a follow-up
        {"files": ["examples/_index/editor/loadTypes.mjs", "examples/_index/editor/monaco.mjs", "examples/_index/editor/setup.mjs", "plugins/*/vite.config.js", "scripts/vite-utils.mjs", "src/assetmanager/AssetImporter.ts", "tests/interactive.spec.ts", "vite.config.js", "vite.examples.config.js", "website/.worker/cf.js", "website/public/scripts/home-3d-abstract.js", "website/public/scripts/home-viewer.js", "website/public/scripts/viewer-controls.js"], "rules": {"no-unused-vars": "off"}}
    ]
}
