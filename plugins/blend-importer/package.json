{
    "name": "@threepipe/plugin-blend-importer",
    "description": "Importer for Blender .blend files, for threepipe and plain three.js",
    "version": "0.3.1",
    "devDependencies": {
        "fflate": "^0.8.2"
    },
    "dependencies": {
        "fzstd": "^0.1.1",
        "threepipe": "file:./../../src/"
    },
    "peerDependencies": {
        "threepipe": ">=0.1.0",
        "three": ">=0.125.0"
    },
    "peerDependenciesMeta": {
        "threepipe": {
            "optional": true
        },
        "three": {
            "optional": true
        }
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./three": {
            "types": "./dist/threejs.d.ts",
            "import": "./dist/threejs.mjs",
            "require": "./dist/threejs.js"
        },
        "./dist/": {
            "import": "./dist/",
            "require": "./dist/"
        }
    },
    "clean-package": {
        "remove": [
            "clean-package",
            "scripts",
            "devDependencies"
        ],
        "replace": {
            "dependencies": {}
        }
    },
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "src", "README.md", "CHANGELOG.md", "docs", "tsconfig.json"
    ],
    "scripts": {
        "new:pack": "npm run prepare 1>&2 && npm run docs 1>&2 && clean-package && npm pack --silent && clean-package restore",
        "prepare": "npm run build",
        "build": "rimraf dist && vite build && vite build -c vite.three.config.js",
        "dev": "NODE_ENV=development vite build --watch",
        "docs": "rimraf docs && npx typedoc --skipErrorChecking"
    },
    "author": "repalash <palash@shaders.app>",
    "license": "Apache-2.0",
    "keywords": [
        "three.js",
        "three",
        "threepipe",
        "importer",
        "blend",
        "blender",
        "plugin"
    ],
    "bugs": {
        "url": "https://github.com/repalash/threepipe/issues"
    },
    "homepage": "https://github.com/repalash/threepipe#readme",
    "repository": {
        "type": "git",
        "url": "git://github.com/repalash/threepipe.git",
        "directory": "plugins/blend-importer"
    }
}
