{
    "name": "@threepipe/plugin-gltf-transform",
    "description": "Utility plugins for threepipe using gltf-transform to optimize/compress glTF files.",
    "version": "0.3.0",
    "devDependencies": {
        "@gltf-transform/core": "4.2.0",
        "@gltf-transform/extensions": "4.2.0",
        "@gltf-transform/functions": "4.2.0"
    },
    "dependencies": {
        "threepipe": "file:./../../src/"
    },
    "peerDependencies": {
        "threepipe": ">=0.1.0"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./dist/": {
            "import": "./dist/",
            "require": "./dist/"
        },
        "./lib": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.js"
        },
        "./lib/": {
            "import": "./lib/"
        }
    },
    "clean-package": {
        "remove": [
            "clean-package",
            "scripts",
            "devDependencies"
        ],
        "replace": {
            "dependencies": {}
        }
    },
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "lib",
        "src", "README.md", "CHANGELOG.md", "docs", "tsconfig.json"
    ],
    "scripts": {
        "new:pack": "npm run prepare 1>&2 && npm run docs 1>&2 && clean-package && npm pack --silent && clean-package restore",
        "prepare": "npm run build",
        "compile:esm": "vite build --config vite.lib.config.js",
        "compile": "rimraf lib && npm run compile:esm",
        "build": "npm run compile && rimraf dist && vite build",
        "dev": "NODE_ENV=development vite build --watch",
        "docs": "rimraf docs && npx typedoc --skipErrorChecking"
    },
    "author": "repalash <palash@shaders.app>",
    "license": "Apache-2.0",
    "keywords": [
        "three",
        "three.js",
        "threepipe",
        "vite",
        "plugin"
    ],
    "bugs": {
        "url": "https://github.com/repalash/threepipe/issues"
    },
    "homepage": "https://github.com/repalash/threepipe#readme",
    "repository": {
        "type": "git",
        "url": "git://github.com/repalash/threepipe.git",
        "directory": "plugins/gltf-transform"
    }
}
