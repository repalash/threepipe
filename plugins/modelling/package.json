{
    "name": "@threepipe/plugin-modelling",
    "description": "Scriptable modelling command API for threepipe - JSON commands an agent or a script can drive, with a document model, undo and inspection",
    "version": "0.1.0",
    "devDependencies": {},
    "dependencies": {
        "threepipe": "file:./../../src/",
        "@threepipe/mesh-kernel": "file:./../mesh-kernel/src/"
    },
    "peerDependencies": {
        "threepipe": ">=0.5.0",
        "@threepipe/mesh-kernel": ">=0.1.0"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./dist/": {
            "import": "./dist/",
            "require": "./dist/"
        }
    },
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "new:pack": "npm run prepare 1>&2 && npm run docs 1>&2 && clean-package && npm pack --silent && clean-package restore",
        "prepare": "npm run build",
        "build": "rimraf dist && vite build",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "dev": "NODE_ENV=development vite build --watch",
        "docs": "rimraf docs && npx typedoc --skipErrorChecking",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "author": "repalash <palash@shaders.app>",
    "license": "Apache-2.0",
    "keywords": [
        "three",
        "three.js",
        "threepipe",
        "modelling",
        "agent",
        "scripting",
        "api"
    ],
    "bugs": {
        "url": "https://github.com/repalash/threepipe/issues"
    },
    "homepage": "https://github.com/repalash/threepipe#readme",
    "repository": {
        "type": "git",
        "url": "git://github.com/repalash/threepipe.git",
        "directory": "plugins/modelling"
    },
    "clean-package": {
        "remove": [
            "clean-package",
            "scripts",
            "devDependencies",
            "overrides",
            "//"
        ],
        "replace": {
            "dependencies": {}
        }
    }
}
