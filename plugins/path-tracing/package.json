{
    "name": "@threepipe/plugin-path-tracing",
    "description": "Path tracing plugin interfaces for Threepipe",
    "version": "0.2.0",
    "devDependencies": {
        "three-gpu-pathtracer": "^0.0.23",
        "three-mesh-bvh": "^0.9.16"
    },
    "dependencies": {
        "threepipe": "file:./../../src/"
    },
    "peerDependencies": {
        "threepipe": ">=0.4.0",
        "three-gpu-pathtracer": "^0.0.23"
    },
    "peerDependenciesMeta": {
        "three-gpu-pathtracer": {
            "optional": true
        }
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./dist/": {
            "import": "./dist/",
            "require": "./dist/"
        }
    },
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "src", "README.md", "CHANGELOG.md", "docs", "tsconfig.json"
    ],
    "scripts": {
        "new:pack": "npm run build 1>&2 && npm run docs 1>&2 && clean-package && npm pack --silent && clean-package restore",
        "build": "rimraf dist && vite build",
        "watch": "NODE_ENV=development vite build --watch",
        "docs": "rimraf docs && npx typedoc --skipErrorChecking"
    },
    "author": "repalash <palash@shaders.app>",
    "license": "Apache-2.0",
    "keywords": [
        "three",
        "three.js",
        "threepipe",
        "path-tracing",
        "three-gpu-pathtracer",
        "rendering"
    ],
    "bugs": {
        "url": "https://github.com/repalash/threepipe/issues"
    },
    "homepage": "https://github.com/repalash/threepipe#readme",
    "repository": {
        "type": "git",
        "url": "git://github.com/repalash/threepipe.git",
        "directory": "plugins/path-tracing"
    },
    "clean-package": {
        "remove": [
            "clean-package",
            "scripts",
            "devDependencies",
            "overrides",
            "//"
        ],
        "replace": {
            "dependencies": {}
        }
    }
}
