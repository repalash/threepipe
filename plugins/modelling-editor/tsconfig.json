{
    "compilerOptions": {
        "baseUrl": ".",
        "allowJs": false,
        "checkJs": false,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "experimentalDecorators": true,
        "isolatedModules": true,
        "module": "es2020",
        "jsx": "react-jsx",
        "noImplicitAny": true,
        "declaration": true,
        "declarationMap": true,
        "declarationDir": "dist",
        "outDir": "dist",
        "noImplicitThis": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "removeComments": false,
        "preserveConstEnums": true,
        "moduleResolution": "bundler",
        "emitDecoratorMetadata": false,
        "sourceMap": true,
        "target": "ES2021",
        "strictNullChecks": true,
        "allowImportingTsExtensions": true,
        "lib": [
            "es2020",
            "esnext",
            "dom",
            "dom.iterable"
        ],
        "paths": {
            "threepipe": ["../../dist/index.d.ts"],
            "@threepipe/mesh-kernel": ["../mesh-kernel/src/index.ts"],
            "@threepipe/plugin-mesh-edit": ["../mesh-edit/src/index.ts"],
            "@threepipe/plugin-modelling": ["../modelling/src/index.ts"],
            "@threepipe/plugin-editor-engine": ["../editor-engine/src/index.ts"]
        }
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "**/*.spec.ts",
        "**/*.test.ts",
        "dist"
    ]
}
