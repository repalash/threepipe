{
    "name": "@threepipe/modelling-parts",
    "description": "Parametric parts for threepipe modelling - knurled rings, dials, buttons, pads, eyecups, lugs, lens barrels - as editable n-gon meshes, and SVG layouts for printed markings",
    "version": "0.1.0",
    "devDependencies": {},
    "dependencies": {
        "@threepipe/mesh-kernel": "file:./../mesh-kernel/src/"
    },
    "peerDependencies": {
        "@threepipe/mesh-kernel": ">=0.1.0"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./dist/": {
            "import": "./dist/",
            "require": "./dist/"
        }
    },
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "new:pack": "npm run prepare 1>&2 && npm run docs 1>&2 && clean-package && npm pack --silent && clean-package restore",
        "prepare": "npm run build",
        "build": "rimraf dist && vite build",
        "dev": "NODE_ENV=development vite build --watch",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "docs": "rimraf docs && npx typedoc --skipErrorChecking",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "author": "repalash <palash@shaders.app>",
    "license": "Apache-2.0",
    "keywords": [
        "threepipe",
        "modelling",
        "parts",
        "parametric",
        "geometry"
    ],
    "bugs": {
        "url": "https://github.com/repalash/threepipe/issues"
    },
    "homepage": "https://github.com/repalash/threepipe#readme",
    "repository": {
        "type": "git",
        "url": "git://github.com/repalash/threepipe.git",
        "directory": "plugins/modelling-parts"
    },
    "clean-package": {
        "remove": [
            "clean-package",
            "scripts",
            "devDependencies",
            "overrides",
            "//"
        ],
        "replace": {
            "dependencies": {}
        }
    }
}
