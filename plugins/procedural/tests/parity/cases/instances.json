 {
  "id": "iop-selection-realize",
  "description": "Every other point, then realized",
  "library": {
   "iop-selection-realize": {
    "name": "iop-selection-realize",
    "interface": [
     {
      "inOut": "OUTPUT",
      "name": "Geometry",
      "identifier": "Socket_0",
      "socketType": "NodeSocketGeometry"
     }
    ],
    "nodes": [
     {
      "name": "Grid",
      "type": "GeometryNodeMeshGrid",
      "properties": {},
      "inputs": {
       "Vertices X": 3,
       "Vertices Y": 4
      }
     },
     {
      "name": "Cube",
      "type": "GeometryNodeMeshCube",
      "properties": {},
      "inputs": {
       "Vertices X": 3
      }
     },
     {
      "name": "Index",
      "type": "GeometryNodeInputIndex",
      "properties": {},
      "inputs": {}
     },
     {
      "name": "Math",
      "type": "ShaderNodeMath",
      "properties": {
       "operation": "MODULO"
      },
      "inputs": {
       "Value_001": 2
      }
     },
     {
      "name": "Compare",
      "type": "FunctionNodeCompare",
      "properties": {
       "data_type": "FLOAT",
       "operation": "EQUAL"
      },
      "inputs": {
       "B": 0
      }
     },
     {
      "name": "Instance on Points",
      "type": "GeometryNodeInstanceOnPoints",
      "properties": {},
      "inputs": {
       "Scale": [
        0.25,
        0.25,
        0.25
       ]
      }
     },
     {
      "name": "Realize Instances",
      "type": "GeometryNodeRealizeInstances",
      "properties": {},
      "inputs": {}
     },
     {
      "name": "Group Output",
      "type": "NodeGroupOutput"
     }
    ],
    "links": [
     {
      "from": [
       "Index",
       "Index"
      ],
      "to": [
       "Math",
       "Value"
      ]
     },
     {
      "from": [
       "Math",
       "Value"
      ],
      "to": [
       "Compare",
       "A"
      ]
     },
     {
      "from": [
       "Grid",
       "Mesh"
      ],
      "to": [
       "Instance on Points",
       "Points"
      ]
     },
     {
      "from": [
       "Cube",
       "Mesh"
      ],
      "to": [
       "Instance on Points",
       "Instance"
      ]
     },
     {
      "from": [
       "Compare",
       "Result"
      ],
      "to": [
       "Instance on Points",
       "Selection"
      ]
     },
     {
      "from": [
       "Instance on Points",
       "Instances"
      ],
      "to": [
       "Realize Instances",
       "Geometry"
      ]
     },
     {
      "from": [
       "Realize Instances",
       "Geometry"
      ],
      "to": [
       "Group Output",
       "Socket_0"
      ]
     }
    ]
   }
  },
  "group": "iop-selection-realize",
  "input": "empty"
 },
 {
  "id": "translate-scale-instances",
  "description": "Translate (local and global), then scale around a center",
  "library": {
   "translate-scale-instances": {
    "name": "translate-scale-instances",
    "interface": [
     {
      "inOut": "OUTPUT",
      "name": "Geometry",
      "identifier": "Socket_0",
      "socketType": "NodeSocketGeometry"
     }
    ],
    "nodes": [
     {
      "name": "Mesh Line",
      "type": "GeometryNodeMeshLine",
      "properties": {},
      "inputs": {
       "Count": 4
      }
     },
     {
      "name": "Cube",
      "type": "GeometryNodeMeshCube",
      "properties": {},
      "inputs": {}
     },
     {
      "name": "Instance on Points",
      "type": "GeometryNodeInstanceOnPoints",
      "properties": {},
      "inputs": {
       "Rotation": [
        0.5,
        0.2,
        0.9
       ],
       "Scale": [
        1,
        2,
        0.5
       ]
      }
     },
     {
      "name": "Index",
      "type": "GeometryNodeInputIndex",
      "properties": {},
      "inputs": {}
     },
     {
      "name": "Compare",
      "type": "FunctionNodeCompare",
      "properties": {
       "data_type": "INT",
       "operation": "LESS_THAN"
      },
      "inputs": {
       "B": 2
      }
     },
     {
      "name": "Translate Instances",
      "type": "GeometryNodeTranslateInstances",
      "properties": {},
      "inputs": {
       "Translation": [
        0.5,
        1,
        -0.25
       ]
      }
     },
     {
      "name": "Index.001",
      "type": "GeometryNodeInputIndex",
      "properties": {},
      "inputs": {}
     },
     {
      "name": "Compare.001",
      "type": "FunctionNodeCompare",
      "properties": {
       "data_type": "INT",
       "operation": "GREATER_THAN"
      },
      "inputs": {
       "B": 1
      }
     },
     {
      "name": "Scale Instances",
      "type": "GeometryNodeScaleInstances",
      "properties": {},
      "inputs": {
       "Scale": [
        1.5,
        0.5,
        2
       ],
       "Center": [
        0.1,
        0.2,
        0.3
       ]
      }
     },
     {
      "name": "Group Output",
      "type": "NodeGroupOutput"
     }
    ],
    "links": [
     {
      "from": [
       "Mesh Line",
       "Mesh"
      ],
      "to": [
       "Instance on Points",
       "Points"
      ]
     },
     {
      "from": [
       "Cube",
       "Mesh"
      ],
      "to": [
       "Instance on Points",
       "Instance"
      ]
     },
     {
      "from": [
       "Index",
       "Index"
      ],
      "to": [
       "Compare",
       "A"
      ]
     },
     {
      "from": [
       "Instance on Points",
       "Instances"
      ],
      "to": [
       "Translate Instances",
       "Instances"
      ]
     },
     {
      "from": [
       "Compare",
       "Result"
      ],
      "to": [
       "Translate Instances",
       "Local Space"
      ]
     },
     {
      "from": [
       "Index.001",
       "Index"
      ],
      "to": [
       "Compare.001",
       "A"
      ]
     },
     {
      "from": [
       "Translate Instances",
       "Instances"
      ],
      "to": [
       "Scale Instances",
       "Instances"
      ]
     },
     {
      "from": [
       "Compare.001",
       "Result"
      ],
      "to": [
       "Scale Instances",
       "Local Space"
      ]
     },
     {
      "from": [
       "Scale Instances",
       "Instances"
      ],
      "to": [
       "Group Output",
       "Socket_0"
      ]
     }
    ]
   }
  },
  "group": "translate-scale-instances",
  "input": "empty"
 }
