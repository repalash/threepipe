{
    "name": "@threepipe/plugin-procedural",
    "description": "Blender geometry nodes for threepipe, ported from Blender 5.2 LTS source - evaluated live in the browser and in Node on mesh-kernel's MeshData, as a modifier and as a typed graph API",
    "version": "0.1.0",
    "devDependencies": {
        "three": "npm:three-modded@0.168.10006"
    },
    "dependencies": {
        "@threepipe/mesh-kernel": "file:./../mesh-kernel/src/"
    },
    "peerDependencies": {
        "three": ">=0.168.0",
        "@threepipe/mesh-kernel": ">=0.1.0",
        "threepipe": ">=0.5.0",
        "@threepipe/plugin-modelling": ">=0.1.0"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./plugin": {
            "types": "./dist/plugin/index.d.ts",
            "import": "./dist/plugin.mjs",
            "require": "./dist/plugin.js"
        },
        "./dist/": {
            "import": "./dist/",
            "require": "./dist/"
        }
    },
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "new:pack": "npm run prepare 1>&2 && npm run docs 1>&2 && clean-package && npm pack --silent && clean-package restore",
        "prepare": "npm run build",
        "build": "rimraf dist && vite build && vite build -c vite.plugin.config.js",
        "dev": "NODE_ENV=development vite build --watch",
        "test": "vitest run",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test:watch": "vitest",
        "docs": "rimraf docs && npx typedoc --skipErrorChecking",
        "generate:dsl": "UPDATE_DSL_TYPES=1 vitest run tests/dslTypes.test.ts",
        "typecheck:tests": "tsc --noEmit -p tsconfig.test.json"
    },
    "author": "repalash <palash@shaders.app>",
    "license": "Apache-2.0",
    "keywords": [
        "three",
        "three.js",
        "threepipe",
        "procedural",
        "geometry nodes",
        "blender",
        "mesh"
    ],
    "bugs": {
        "url": "https://github.com/repalash/threepipe/issues"
    },
    "homepage": "https://github.com/repalash/threepipe#readme",
    "repository": {
        "type": "git",
        "url": "git://github.com/repalash/threepipe.git",
        "directory": "plugins/procedural"
    },
    "clean-package": {
        "remove": [
            "clean-package",
            "scripts",
            "devDependencies",
            "overrides",
            "//"
        ],
        "replace": {
            "dependencies": {}
        }
    },
    "peerDependenciesMeta": {
        "threepipe": {
            "optional": true
        },
        "@threepipe/plugin-modelling": {
            "optional": true
        }
    }
}
