{
    "name": "@threepipe/plugin-editor-engine",
    "description": "Framework-free interaction engine for the threepipe modelling editor: operator and tool registries, keymap presets with one input router, one labelled undo history with redo-last, object-mode and edit-mode operators over plugin-modelling and plugin-mesh-edit",
    "version": "0.1.0",
    "devDependencies": {},
    "dependencies": {
        "threepipe": "file:./../../src/",
        "@threepipe/mesh-kernel": "file:./../mesh-kernel/src/",
        "@threepipe/plugin-mesh-edit": "file:./../mesh-edit/src/",
        "@threepipe/plugin-modelling": "file:./../modelling/src/"
    },
    "peerDependencies": {
        "threepipe": ">=0.5.0",
        "@threepipe/mesh-kernel": ">=0.1.0",
        "@threepipe/plugin-mesh-edit": ">=0.1.0",
        "@threepipe/plugin-modelling": ">=0.1.0"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./dist/": {
            "import": "./dist/",
            "require": "./dist/"
        }
    },
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "source": "src/index.ts",
    "files": [
        "dist",
        "src",
        "README.md",
        "CHANGELOG.md",
        "docs",
        "tsconfig.json"
    ],
    "scripts": {
        "new:pack": "npm run prepare 1>&2 && npm run docs 1>&2 && clean-package && npm pack --silent && clean-package restore",
        "prepare": "npm run build",
        "build": "rimraf dist && vite build",
        "build:dev": "NODE_ENV=development vite build",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "dev": "NODE_ENV=development vite build --watch",
        "docs": "rimraf docs && npx typedoc --skipErrorChecking"
    },
    "author": "repalash <palash@shaders.app>",
    "license": "Apache-2.0",
    "keywords": [
        "three",
        "three.js",
        "threepipe",
        "editor",
        "modelling",
        "keymap",
        "undo",
        "operators"
    ],
    "bugs": {
        "url": "https://github.com/repalash/threepipe/issues"
    },
    "homepage": "https://github.com/repalash/threepipe#readme",
    "repository": {
        "type": "git",
        "url": "git://github.com/repalash/threepipe.git",
        "directory": "plugins/editor-engine"
    },
    "clean-package": {
        "remove": [
            "clean-package",
            "scripts",
            "devDependencies",
            "overrides",
            "//"
        ],
        "replace": {
            "dependencies": {}
        }
    }
}
