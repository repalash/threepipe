{
    "name": "@threepipe/plugin-annotations",
    "description": "3D annotations for ThreePipe: numbered markers on objects with a title, a text and a camera view, saved in the scene",
    "version": "0.1.0",
    "dependencies": {
        "threepipe": "file:./../../src/"
    },
    "peerDependencies": {
        "threepipe": ">=0.6.0"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./dist/": {
            "import": "./dist/",
            "require": "./dist/"
        }
    },
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "src",
        "README.md",
        "CHANGELOG.md",
        "docs",
        "tsconfig.json"
    ],
    "scripts": {
        "new:pack": "npm run build 1>&2 && npm run docs 1>&2 && clean-package && npm pack --silent && clean-package restore",
        "build": "rimraf dist && vite build",
        "watch": "NODE_ENV=development vite build --watch",
        "docs": "rimraf docs && npx typedoc --skipErrorChecking"
    },
    "author": "repalash <palash@shaders.app>",
    "license": "Apache-2.0",
    "keywords": [
        "three",
        "three.js",
        "threepipe",
        "vite",
        "plugin",
        "annotations",
        "hotspots"
    ],
    "bugs": {
        "url": "https://github.com/repalash/threepipe/issues"
    },
    "homepage": "https://github.com/repalash/threepipe#readme",
    "repository": {
        "type": "git",
        "url": "git://github.com/repalash/threepipe.git",
        "directory": "plugins/annotations"
    },
    "clean-package": {
        "remove": [
            "clean-package",
            "scripts",
            "devDependencies",
            "//"
        ],
        "replace": {
            "dependencies": {}
        }
    }
}
